# User defined Environment Settings

MAILNAME=abc.mail.to
CONFIG_FILE=/opt/doc/mailtainer-cfg.yml
ENABLE_LETSENCRYPT=0
ENABLE_DKIM=1
# Must match the DNS record: <selector>._domainkey.<domain>
DKIM_SELECTOR=mail
# Demo key for local testing only. Do not use in production.
DKIM_PRIVATE_KEY_FILE=/opt/doc/dkim-demo.private
# fail = abort startup on invalid SPF/DKIM/DMARC, ignore = log warnings and continue
VALIDATION_ERROR=fail

## Pass: test
